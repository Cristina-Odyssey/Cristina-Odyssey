  btn.className=completed?"secondary":"primary";
  btn.textContent=completed?
   "Opnieuw spelen":"Start challenge";

  btn.onclick=()=>startModule(m.id);

  card.append(icon,title,desc,status,btn);
  container.appendChild(card);
 });

 updateTotal();
}

/* TOTAALSCORE */

function updateTotal(){
 const score=Object.values(results)
  .reduce((s,r)=>s+r.score,0);

 const total=Object.values(results)
  .reduce((s,r)=>s+r.total,0);

 $("totalScore").textContent=score+" / "+total;
}

/* CHALLENGE STARTEN */

function startModule(id){
 activeModule=modules.find(m=>m.id===id);

 if(!activeModule)return;

 questionIndex=0;
 moduleScore=0;
 selectedAnswer=null;

 // Oude antwoorden van deze challenge vervangen
 // wanneer de speler opnieuw begint.
 answersLog=answersLog.filter(
  item=>item.module!==activeModule.title
 );

 $("dashboard").classList.add("hidden");
 $("finalScreen").classList.add("hidden");
 $("quizScreen").classList.remove("hidden");

 $("quizTitle").textContent=
  activeModule.emoji+" "+activeModule.title;

 showQuestion();
}

/* VRAAG WEERGEVEN */

function showQuestion(){
 const q=activeModule.questions[questionIndex];

 selectedAnswer=null;

 $("questionNumber").textContent=
  "Vraag "+(questionIndex+1)+
  " van "+activeModule.questions.length;

 $("progressBar").style.width=
  (questionIndex/activeModule.questions.length*100)+"%";

 $("questionText").textContent=q.q;

 $("options").innerHTML="";
 $("feedback").classList.add("hidden");
 $("nextButton").classList.add("hidden");

 q.o.forEach((option,index)=>{
  const btn=document.createElement("button");

  btn.className="option";
  btn.textContent=
   String.fromCharCode(65+index)+") "+option;

  btn.onclick=()=>selectAnswer(index);

  $("options").appendChild(btn);
 });
}

/* ANTWOORD CONTROLEREN */

function selectAnswer(index){
 if(selectedAnswer!==null)return;

 selectedAnswer=index;

 const q=activeModule.questions[questionIndex];
 const correct=index===q.a;

 if(correct){
  moduleScore++;
 }

 playSound(correct);

 document.querySelectorAll(".option").forEach((btn,i)=>{
  btn.disabled=true;

  if(i===q.a){
   btn.classList.add("correct");
  }

  if(i===index&&!correct){
   btn.classList.add("wrong");
  }
 });

 $("feedback").textContent=
  (correct?"✅ Correct! Goed geredeneerd. ":"❌ Niet helemaal. ")+
  q.e;

 $("feedback").classList.remove("hidden");
 $("nextButton").classList.remove("hidden");

 $("nextButton").textContent=
  questionIndex===activeModule.questions.length-1?
  "Challenge afronden":"Volgende vraag →";

 answersLog.push({
  module:activeModule.title,
  question:q.q,
  answer:q.o[index],
  correct:correct
 });
}

/* VOLGENDE VRAAG */

function nextQuestion(){
 if(selectedAnswer===null)return;

 if(questionIndex<activeModule.questions.length-1){
  questionIndex++;
  showQuestion();
 }else{
  results[activeModule.id]={
   score:moduleScore,
   total:activeModule.questions.length
  };

  $("progressBar").style.width="100%";

  $("quizScreen").classList.add("hidden");
  $("dashboard").classList.remove("hidden");

  renderModules();
 }
}

/* TERUG NAAR DASHBOARD */

function backToDashboard(){
 $("quizScreen").classList.add("hidden");
 $("finalScreen").classList.add("hidden");
 $("dashboard").classList.remove("hidden");

 renderModules();
}

/* EINDRESULTAAT */

function showFinalResult(){
 const completed=modules.every(
  m=>results[m.id]!==undefined
 );

 if(!completed){
  alert(
   "Voltooi eerst alle vier de challenges om je eindresultaat te bekijken."
  );
  return;
 }

 const score=Object.values(results)
  .reduce((s,r)=>s+r.score,0);

 const total=Object.values(results)
  .reduce((s,r)=>s+r.total,0);

 $("dashboard").classList.add("hidden");
 $("finalScreen").classList.remove("hidden");

 $("finalName").textContent=
  "Goed gedaan, "+playerName+"!";

 $("finalScore").textContent=
  score+" / "+total;

 const percentage=Math.round(score/total*100);

 $("finalMessage").textContent=
  percentage>=90?
   "🌟 Uitstekend! Jij bent een echte Green Office Expert!":
  percentage>=75?
   "🌿 Fantastisch werk! Je hebt een sterke kennis van duurzaamheid.":
  percentage>=60?
   "💚 Goed bezig! Je denkt bewust na over duurzaamheid.":
   "🌱 Elke stap telt. Blijf leren en maak samen het verschil!";

 const details=$("finalDetails");
 details.innerHTML="";

 modules.forEach(m=>{
  const p=document.createElement("p");

  p.textContent=
   m.emoji+" "+m.title+": "+
   results[m.id].score+"/"+results[m.id].total;

  details.appendChild(p);
 });

 saveScore(score,total);
}

/* GREEN IDEA KOPIËREN */

async function copyIdea(){
 const category=$("ideaCategory").value;
 const idea=$("ideaText").value.trim();

 if(!idea){
  $("ideaMessage").textContent=
   "Schrijf eerst je idee op.";
  return;
 }

 const content=
  "Green Office Idea\n"+
  "Naam: "+playerName+
  "\nCategorie: "+category+
  "\nIdee: "+idea;

 try{
  if(navigator.clipboard&&window.isSecureContext){
   await navigator.clipboard.writeText(content);
  }else{
   const temporary=document.createElement("textarea");
   temporary.value=content;
   temporary.style.position="fixed";
   temporary.style.opacity="0";

   document.body.appendChild(temporary);
   temporary.select();

   const copied=document.execCommand("copy");
   temporary.remove();

   if(!copied)throw new Error("Kopiëren mislukt");
  }

  $("ideaMessage").textContent=
   "Je idee is gekopieerd! Bezorg het via het afgesproken interne kanaal.";

 }catch(error){
  $("ideaMessage").textContent=
   "Kopiëren is niet gelukt. Selecteer en kopieer je idee handmatig.";
 }
}

/* SCORE OPSLAAN IN GOOGLE SHEETS */

function saveScore(score,total){
 if(!SCORE_ENDPOINT)return;

 const data={
  name:playerName,
  score:score,
  total:total,
  answers:answersLog,
  date:new Date().toISOString()
 };

 fetch(SCORE_ENDPOINT,{
  method:"POST",
  mode:"no-cors",
  body:JSON.stringify(data)
 }).catch(error=>{
  console.log("Score niet verzonden:",error);
 });
}

</script>
