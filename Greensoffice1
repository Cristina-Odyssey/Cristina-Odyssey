<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Green Office Challenge</title>
<style>
:root {
  --green:#18794e;
  --dark:#124c35;
  --mint:#e9f5ed;
  --light:#f5f8f5;
  --text:#24352b;
  --muted:#718078;
  --white:#fff;
}
* {box-sizing:border-box}
body {
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:var(--light);
  color:var(--text);
}
header {
  background:linear-gradient(130deg,#103e2d,#23865a);
  color:white;
  padding:48px 20px;
  text-align:center;
}
header .leaf {font-size:38px}
header h1 {font-size:clamp(28px,5vw,43px);margin:12px 0}
header p {max-width:550px;margin:auto;line-height:1.7;color:#e3f4e9}
.container {max-width:900px;margin:30px auto;padding:0 18px}
.card {
  background:white;
  border-radius:18px;
  padding:25px;
  margin-bottom:20px;
  box-shadow:0 5px 20px rgba(20,70,40,.06);
}
h2 {color:var(--dark);margin-top:0}
h3 {margin:8px 0}
.muted {color:var(--muted);line-height:1.6}
input,textarea,select {
  width:100%;
  padding:13px;
  border:1px solid #d6e2d9;
  border-radius:9px;
  font:inherit;
  margin:8px 0 15px;
  background:white;
}
textarea {min-height:110px;resize:vertical}
button {
  border:0;
  border-radius:10px;
  padding:13px 19px;
  font:inherit;
  font-weight:600;
  cursor:pointer;
  transition:.2s;
}
button:hover {transform:translateY(-1px);filter:brightness(.97)}
.primary {background:var(--green);color:white}
.secondary {background:var(--mint);color:var(--dark)}
.outline {background:white;border:1px solid #d6e2d9;color:var(--dark)}
button:disabled {opacity:.45;cursor:not-allowed;transform:none}
.grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:15px;
}
.module {
  border:1px solid #e3ebe5;
  border-radius:14px;
  padding:19px;
  background:#fff;
}
.module .emoji {font-size:29px}
.module p {color:var(--muted);font-size:14px;line-height:1.5}
.module button {width:100%;margin-top:8px}
.hidden {display:none!important}
.progress {
  height:8px;
  background:#e8eee9;
  border-radius:20px;
  overflow:hidden;
  margin:18px 0;
}
.progress div {
  height:100%;
  background:var(--green);
  width:0;
  transition:.3s;
}
.option {
  display:block;
  width:100%;
  text-align:left;
  margin:10px 0;
  background:#f5f8f5;
  border:1px solid #dce8df;
  color:var(--text);
}
.option:hover {background:var(--mint)}
.option.selected {border:2px solid var(--green);background:var(--mint)}
.option.correct {
  border:2px solid #18794e;
  background:#e3f5e9;
}
.option.wrong {
  border:2px solid #c94b4b;
  background:#fff0f0;
}
.feedback {
  background:var(--mint);
  border-radius:12px;
  padding:15px;
  margin:15px 0;
  line-height:1.6;
}
.score {
  font-size:42px;
  font-weight:800;
  color:var(--green);
  text-align:center;
  margin:12px;
}
.idea {
  border-left:4px solid #6eaa83;
  background:#f4f8f4;
  padding:15px;
  margin:12px 0;
  border-radius:5px;
}
.sound-control {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  margin-top:12px;
}
.sound-control button {min-width:145px}
footer {
  text-align:center;
  padding:30px;
  color:var(--muted);
  font-size:13px;
}
@media(max-width:600px) {
  .grid {grid-template-columns:1fr}
  header {padding:35px 18px}
  .card {padding:19px}
}
</style>
</head>
